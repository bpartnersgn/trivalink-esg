{
  "name": "trivalink-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API TRIVALINK ESG : socle de production (PostgreSQL, RLS, MFA, audit chaîné)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=../.env src/server.js",
    "migrate": "node --env-file-if-exists=../.env scripts/migrate.js",
    "seed": "node --env-file-if-exists=../.env scripts/seed.js",
    "test": "node --test test/*.test.js",
    "check": "find src scripts -name '*.js' -exec node --check {} +"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1"
  }
}
