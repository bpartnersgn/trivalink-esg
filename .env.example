# Copier en .env pour le développement local (jamais commité).
NODE_ENV=development
PORT=3000
# Rôle applicatif (soumis à la RLS) et rôle propriétaire (migrations, démonstration)
DATABASE_URL=postgres://trivalink_app:trivalink_app_dev@localhost:5432/trivalink
DATABASE_MIGRATION_URL=postgres://trivalink_owner:trivalink_owner_dev@localhost:5432/trivalink
# Migrations au démarrage : 1 par défaut en dev si DATABASE_MIGRATION_URL est défini, 0 en production
# TRIVALINK_MIGRATE_ON_START=1
# Jeu de démonstration (interdit en production)
TRIVALINK_SEED=1
# Clé maîtresse de chiffrement (preuves, secrets MFA). Obligatoire et >= 32 caractères en production.
# Sa perte rend toutes les preuves illisibles : la conserver dans un coffre, à deux détenteurs.
# TRIVALINK_STORAGE_KEY=
TRIVALINK_STORAGE_DIR=data/evidence
# Nombre de proxys de confiance devant l'API (adresse IP réelle pour l'anti force brute)
# TRUST_PROXY=1
LOG_LEVEL=debug
